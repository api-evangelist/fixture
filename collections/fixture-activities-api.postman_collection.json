      "name": "Activities",
      "description": {
        "content": "List and ingest CRM Activity records.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c84a2f02-6e5c-44c0-8841-c93aef3dd1a6",
          "name": "List Activities",
          "request": {
            "name": "List Activities",
            "description": {
              "content": "Return a paginated list of Activities across all CRM entities. Pass `entity_type` and `entity_id` together to scope results to one Account, Contact, Deal, or Lead. Also supports filtering by `event_type` and `occurred_after`/`occurred_before` windows. Sort supports `occurred_at` or `-occurred_at`; pagination uses `limit` and `cursor`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "activities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of records to return."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque cursor returned by the previous page. Omit for the first page."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "-occurred_at",
                  "description": "Sort by a supported field. Prefix with `-` for descending order."
                },
                {
                  "disabled": false,
                  "key": "entity_type",
                  "value": "<string>",
                  "description": "Filter to a specific related entity type."
                },
                {
                  "disabled": false,
                  "key": "entity_id",
                  "value": "<string>",
                  "description": "Filter to one specific related entity. Requires `entity_type`."
                },
                {
                  "disabled": false,
                  "key": "event_type",
                  "value": "<string>",
                  "description": "Filter Activities by event type."
                },
                {
                  "disabled": false,
                  "key": "occurred_after",
                  "value": "<dateTime>",
                  "description": "Return only Activities that occurred after this ISO 8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "occurred_before",
                  "value": "<dateTime>",
                  "description": "Return only Activities that occurred before this ISO 8601 timestamp."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
