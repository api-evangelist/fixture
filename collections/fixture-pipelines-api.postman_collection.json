        {
          "id": "d7e3936f-26ad-4ff9-afb7-dceefd2da7d1",
          "name": "List Pipelines",
          "request": {
            "name": "List Pipelines",
            "description": {
              "content": "Return every Pipeline in the organization with its ordered stage definitions nested inline. Pipelines are the container for Deal stages — read this first to discover valid `pipeline_id` and `pipeline_stage_id` values for the Deal endpoints. Sort supports `created_at` or `-created_at`; pagination uses `limit` and `cursor`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "pipelines"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of records to return."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque cursor returned by the previous page. Omit for the first page."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "-created_at",
                  "description": "Sort by a supported field. Prefix with `-` for descending order."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
