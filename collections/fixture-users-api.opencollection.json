{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fixture Accounts Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://beta-api.fixture.app/api/v1/users",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return organization Users that can be assigned as Account or Deal owners. Use these `user_` IDs in `relationships.owner.set`."
        }
      ]
    }
  ],
  "bundled": true
}